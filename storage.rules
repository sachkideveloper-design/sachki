rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de perfil: fotos_perfil/{uid}.jpg
    match /fotos_perfil/{uid} {
      // Solo alguien con sesión puede VER fotos (para que el staff verifique en recepción)
      allow read: if request.auth != null;
      // Solo el dueño de la cuenta puede subir/reemplazar SU PROPIA foto.
      // Límite de 5MB y debe ser una imagen (evita que suban PDFs, videos, etc.)
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
